				"associatedDomain": {
					"type": "string",
					"example": "example.com",
					"description": "Associated domain"
				},
				"email": {
					"type": "string",
					"example": "john.doe@example.com",
					"description": "Email of the account holder"
				},
				"meetingAcId": {
					"type": "string",
					"example": "12345",
					"description": "Meeting account ID"
				},
				"name": {
					"type": "string",
					"example": "John Doe",
