				}
			},
			"description": "Request object for account information",
			"example": "[{\"meeting_ac_id\":\"12345\",\"associated_domain\":\"example.com\",\"ac_type\":1,\"ac_password\":\"securePassword123\",\"name\":\"John Doe\",\"email\":\"john.doe@example.com\",\"reserved_app_id\":\"app123\",\"reserved_dt\":\"2023-10-01\",\"reserved_telecare_id\":\"tele123\"}]"
		},
		"EndMeetingRequest": {
			"type": "object",
			"required": ["appId", "externalRequestId"],
			"properties": {
